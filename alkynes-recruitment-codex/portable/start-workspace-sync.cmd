@echo off
setlocal
title ALKYNES - Workspace Sync
echo Updating and starting ALKYNES Workspace synchronization...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $base=Join-Path $env:LOCALAPPDATA 'AlkynesRecruitment'; $node=Join-Path $base 'runtime\node.exe'; $tool=Join-Path $base 'tools\workspace-schedule-export.cjs'; if(!(Test-Path -LiteralPath $node)){throw 'Recruitment runtime not found.'}; $sync=Get-ChildItem -LiteralPath 'G:\' -Directory -ErrorAction Stop | ForEach-Object { Join-Path $_.FullName 'SEONGJIN-SYNC' } | Where-Object {Test-Path -LiteralPath $_ -PathType Container} | Select-Object -First 1; if(!$sync){throw 'Google Drive SEONGJIN-SYNC folder not found on drive G:.'}; New-Item -ItemType Directory -Path (Split-Path $tool) -Force | Out-Null; $running=Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -like '*workspace-schedule-export.cjs*' }; $running | ForEach-Object {Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue}; Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/tjdwlsdlek93-spec/alkynes-recruitment/main/alkynes-recruitment-codex/portable/workspace-schedule-export.cjs' -OutFile $tool -ErrorAction Stop; if(!((Get-Content -LiteralPath $tool -Raw) -match 'requestedIds')){throw 'Latest exporter was not downloaded.'}; $q=[char]34; $p=Start-Process -FilePath $node -ArgumentList @(($q+$tool+$q),($q+$sync+$q)) -WindowStyle Hidden -PassThru; Start-Sleep -Seconds 4; $output=Join-Path $sync 'seongjin-recruitment-schedule.json'; if(!(Test-Path -LiteralPath $output)){throw 'Synced JSON not created.'}; $j=Get-Content -LiteralPath $output -Raw -Encoding UTF8 | ConvertFrom-Json; Write-Host ('SUCCESS - Running PID: '+$p.Id); Write-Host ('IN PROGRESS applicants: '+@($j.inProgressCandidates).Count); Write-Host ('Exported at: '+$j.generatedAt); Write-Host 'This window can now be closed.'; exit 0 } catch {Write-Host ('ERROR: '+$_.Exception.Message); exit 1}"
echo.
pause
